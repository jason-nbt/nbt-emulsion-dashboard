import os
import requests
from requests.auth import HTTPBasicAuth
from supabase import create_client, Client

# ================= 1. 配置信息 =================
# 在本地测试时，你可以直接把这里换成你的真实字符串（测试成功后，再换成环境变量放到 Github Actions 里）
SUPABASE_URL = "https://xxxxxx.supabase.co"
SUPABASE_KEY = "你的_SUPABASE_SERVICE_ROLE_KEY" # 注意：一定要用 Service Role Key，才能强制写入

JIRA_DOMAIN = "你的公司.atlassian.net"
JIRA_EMAIL = "你的邮箱@example.com"
JIRA_TOKEN = "你刚刚申请的_JIRA_API_TOKEN"
JQL_QUERY = 'project = "YOUR_PROJECT_KEY"' # 你可以在这里写 JQL，比如只抓取特定项目的数据

# 初始化 Supabase 客户端
supabase: Client = create_client(SUPABASE_URL, SUPABASE_KEY)

# ================= 2. 从 Jira 获取数据 =================
def fetch_jira_issues():
    issues_list = []
    start_at = 0
    max_results = 50
    
    while True:
        print(f"正在获取 Jira 数据，起始位置: {start_at}...")
        url = f"https://{JIRA_DOMAIN}/rest/api/3/search"
        
        query = {
            'jql': JQL_QUERY,
            'startAt': start_at,
            'maxResults': max_results,
            # 可以指定只返回你需要的字段，加快速度（下面这些是标准字段，amount/product如果是自定义字段需要填 customfield_xxxxx）
            'fields': 'created,status,resolutiondate,customfield_10001,customfield_10002' 
        }
        
        auth = HTTPBasicAuth(JIRA_EMAIL, JIRA_TOKEN)
        headers = {"Accept": "application/json"}
        
        response = requests.get(url, headers=headers, params=query, auth=auth)
        response.raise_for_status() # 如果请求失败会报错
        
        data = response.json()
        issues = data.get('issues', [])
        if not issues:
            break
            
        issues_list.extend(issues)
        
        # 如果当前拿到的数量小于最大限制，说明已经拿完最后一页了
        if len(issues) < max_results:
            break
            
        start_at += max_results
        
    return issues_list

# ================= 3. 数据清洗与上传 Supabase =================
def sync_to_supabase():
    issues = fetch_jira_issues()
    print(f"共抓取到 {len(issues)} 条数据，开始处理并上传 Supabase...")
    
    formatted_data = []
    
    for issue in issues:
        fields = issue['fields']
        
        # --- 这里的逻辑需要根据你 Jira 实际的自定义字段来修改 ---
        # 假设 Product Type 存在 customfield_10001，Amount 存在 customfield_10002
        raw_product = fields.get('customfield_10001') or "Unknown"
        amount = fields.get('customfield_10002') or 0
        
        # 按照你的需求分类：Emulsion(7种) 和 RHAzyme(OPCC)
        # 这里的判断逻辑你可以根据实际情况调整
        if "OPCC" in str(raw_product):
            product_type = "RHAzyme - OPCC"
        else:
            product_type = f"Emulsion - {raw_product}"

        # 整理成对应 Supabase 表格格式的字典
        row = {
            "id": issue['key'],  # 例如: PROJ-123
            "created_date": fields.get('created'),
            "product_type": product_type,
            "amount": amount,
            "status": fields.get('status', {}).get('name', 'Unknown'),
            "resolved_at": fields.get('resolutiondate') # 如果没解决，这个值是 None，可以存入数据库
        }
        formatted_data.append(row)
        
        # 为了防止单次请求数据太大，我们每 50 条做一次 upsert（批量插入/更新）
        if len(formatted_data) >= 50:
            supabase.table('jira_data').upsert(formatted_data).execute()
            formatted_data = []
            
    # 把剩下的最后一批数据传上去
    if formatted_data:
        supabase.table('jira_data').upsert(formatted_data).execute()
        
    print("数据同步完成！")

if __name__ == "__main__":
    sync_to_supabase()
